# Copy to .env.local and fill in. Never commit .env.local.
# Most vars here are SERVER-ONLY. NEXT_PUBLIC_SITE_URL is intentionally public (non-secret origin only).
# Any other NEXT_PUBLIC_ prefix would ship secrets to the browser.

# ── MongoDB ──────────────────────────────────────────────────────────
# Stores form submissions only (contact, meetings, applications).
# Never page content. Contains credentials — treat as a secret.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017
MONGODB_URI=

# Database name. Collections are created on first write.
MONGODB_DB=cranedev

# ── GitHub ("Recently shipped" panel / open-source section) ─────────
# Which account (user or organisation) the site reads public activity
# from. Leave blank and nothing is fetched: the hero hides its panel and
# the open-source section renders the fallback in content/opensource.json.
GITHUB_OWNER=

# Optional. Without it the API still works at the unauthenticated rate
# limit (60 requests/hour per IP — the site makes three per hour), and the
# sections fall back to content/ on failure.
# Needs public_repo scope only — never a token with write access.
GITHUB_TOKEN=

# ── Site ─────────────────────────────────────────────────────────────
# Absolute origin, used for OG tags and canonical URLs. No trailing slash.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
